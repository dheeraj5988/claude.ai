{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, role, status, and usage counters",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "password": {
          "type": "string",
          "description": "User account password"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "User authorization role"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"],
          "description": "Account status"
        },
        "plan": {
          "type": "string",
          "enum": ["Free", "Pro", "Max"],
          "description": "Subscription tier"
        },
        "dailyMessageCount": {
          "type": "number",
          "description": "Messages sent today"
        },
        "monthlyMessageCount": {
          "type": "number",
          "description": "Messages sent this month"
        },
        "createdAt": {
          "type": "number",
          "description": "Account creation timestamp"
        },
        "lastSeenAt": {
          "type": "number",
          "description": "Latest activity timestamp"
        }
      },
      "required": ["id", "role", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User conversation thread with user message counter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation ID"
        },
        "title": {
          "type": "string",
          "description": "Conversation title"
        },
        "userMessageCount": {
          "type": "number",
          "description": "Total user messages sent in conversation"
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Snippet of last message"
        },
        "archived": {
          "type": "boolean",
          "description": "Whether conversation is archived"
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft deletion flag"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "userMessageCount"]
    },
    "MessageRecord": {
      "title": "MessageRecord",
      "description": "Individual message in a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message unique ID"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Message role"
        },
        "content": {
          "type": "string",
          "description": "Text content of message"
        },
        "provider": {
          "type": "string",
          "enum": ["claude", "gemini"],
          "description": "AI provider used"
        },
        "status": {
          "type": "string",
          "enum": ["streaming", "completed", "error"],
          "description": "Generation status"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp"
        }
      },
      "required": ["id", "role", "content"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "activeLogo": {
          "type": "object",
          "description": "Active brand logo"
        },
        "maintenanceMode": {
          "type": "boolean",
          "description": "Maintenance mode status"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      }
    },
    "LiveSession": {
      "title": "LiveSession",
      "description": "Online presence tracking",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID"
        },
        "userName": {
          "type": "string",
          "description": "Display name"
        },
        "lastActiveAt": {
          "type": "number",
          "description": "Heartbeat timestamp"
        }
      },
      "required": ["userId", "lastActiveAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores registered user profiles and usage limits"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Scoped conversations belonging exclusively to userId"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/MessageRecord"
      },
      "description": "Messages inside a user's conversation"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/AppSettings"
      },
      "description": "Application settings and branding"
    },
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/LiveSession"
      },
      "description": "Active connected sessions"
    }
  }
}
