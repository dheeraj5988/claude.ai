# ==============================================================================
# AI Model Providers (Server-side Only - Zero Client Leakage)
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIzaSy...

# Optional model overrides
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# Security & Administrative Access
# ==============================================================================
ADMIN_EMAIL=admin@mydomain.com
SESSION_SECRET=randombyteshere_change_in_production_min32chars
ADMIN_SECRET=claude-admin-2026

# ==============================================================================
# Firebase Firestore Configuration
# ==============================================================================
FIREBASE_PROJECT_ID=my-project-id
# Client-safe configuration (Vite exposes only VITE_ prefixed keys to browser)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=my-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=my-project-id
VITE_FIREBASE_STORAGE_BUCKET=my-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_FIREBASE_DATABASE_ID=(default)

# ==============================================================================
# Quotas, Rate Limiting & Cost Safeguards
# ==============================================================================
DAILY_MESSAGE_LIMIT=50
MONTHLY_MESSAGE_LIMIT=1000
MAX_MESSAGE_CHARACTERS=20000
MAX_CONTEXT_MESSAGES=40
